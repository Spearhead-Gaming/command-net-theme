50 47Z" fill="currentColor"/><path d="M50 51 Q48 51 45 59 Q43 64 47 63 Q49 63 50 60 Q51 63 53 63 Q57 64 55 59 Q52 51 50 51Z" fill="#061d25"/><path d="M50 64 L48 68 L50 67 L52 68Z" fill="#eef3ef"/><path d="M39 71.8 Q38.5 68 39.8 68 Q41.2 68 40.6 71.8 Q39.8 72.6 39 71.8Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M39.2 72.8 L40.6 73.0 Q40.6 75.8 39.8 75.3Z" fill="currentColor"/><g transform="translate(100 0) scale(-1 1)"><path d="M39 71.8 Q38.5 68 39.8 68 Q41.2 68 40.6 71.8 Q39.8 72.6 39 71.8Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M39.2 72.8 L40.6 73.0 Q40.6 75.8 39.8 75.3Z" fill="currentColor"/></g><path d="M41.3 72.69999999999999 Q40.8 68.6 42.199999999999996 68.6 Q43.699999999999996 68.6 43.099999999999994 72.69999999999999 Q42.199999999999996 73.49999999999999 41.3 72.69999999999999Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M41.5 73.69999999999999 L43.099999999999994 73.89999999999999 Q43.099999999999994 76.69999999999999 42.199999999999996 76.19999999999999Z" fill="currentColor"/><g transform="translate(100 0) scale(-1 1)"><path d="M41.3 72.69999999999999 Q40.8 68.6 42.199999999999996 68.6 Q43.699999999999996 68.6 43.099999999999994 72.69999999999999 Q42.199999999999996 73.49999999999999 41.3 72.69999999999999Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M41.5 73.69999999999999 L43.099999999999994 73.89999999999999 Q43.099999999999994 76.69999999999999 42.199999999999996 76.19999999999999Z" fill="currentColor"/></g><path d="M43.9 73.6 Q43.4 69.1 44.9 69.1 Q46.5 69.1 45.9 73.6 Q44.9 74.39999999999999 43.9 73.6Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M44.1 74.6 L45.9 74.8 Q45.9 77.6 44.9 77.1Z" fill="currentColor"/><g transform="translate(100 0) scale(-1 1)"><path d="M43.9 73.6 Q43.4 69.1 44.9 69.1 Q46.5 69.1 45.9 73.6 Q44.9 74.39999999999999 43.9 73.6Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M44.1 74.6 L45.9 74.8 Q45.9 77.6 44.9 77.1Z" fill="currentColor"/></g><path d="M46.7 74.0 Q46.2 69.3 47.900000000000006 69.3 Q49.7 69.3 49.1 74.0 Q47.900000000000006 74.8 46.7 74.0Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M46.900000000000006 75.0 L49.1 75.2 Q49.1 78.0 47.900000000000006 77.5Z" fill="currentColor"/><g transform="translate(100 0) scale(-1 1)"><path d="M46.7 74.0 Q46.2 69.3 47.900000000000006 69.3 Q49.7 69.3 49.1 74.0 Q47.900000000000006 74.8 46.7 74.0Z" fill="currentColor" stroke="#294957" stroke-width=".35"/><path d="M46.900000000000006 75.0 L49.1 75.2 Q49.1 78.0 47.900000000000006 77.5Z" fill="currentColor"/></g></g>',
        'misfit-spade': '<g transform="scale(2.56)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M50 9 C41 21 17 40 15 57 C12 76 27 84 43 74 C43 84 39 90 35 93 L65 93 C61 90 57 84 57 74 C73 84 88 76 85 57 C83 40 59 21 50 9Z" fill="currentColor" fill-opacity=".04" stroke-width="3.5"/><path d="M50 13 C38 28 19 43 18 58" stroke-width=".8" opacity=".45"/></g>',
        'gambler-dice': '<g transform="scale(2.56)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g stroke-width="2.5"><path d="M52 9 L87 18 Q91 19 93 24 L97 35 L78 70 L45 60 L34 43 L48 12Z" fill="#171b18"/><path d="M52 9 L61 24 L45 60 M61 24 L97 35 M61 24 L87 18"/><path d="M49 15 L55 25 L43 48 M66 29 L90 37 L76 63 L52 57" stroke-width="1" opacity=".65"/><g fill="currentColor" stroke="none"><ellipse cx="68" cy="17" rx="2.7" ry="1.8" transform="rotate(15 68 17)"/><ellipse cx="76" cy="39" rx="3" ry="4" transform="rotate(25 76 39)"/><ellipse cx="49" cy="32" rx="2" ry="3" transform="rotate(25 49 32)"/></g><path d="M5 51 L36 31 L64 48 L62 79 L33 96 L10 80Z" fill="currentColor" fill-opacity=".83"/><path d="M5 51 L32 68 L64 48 M32 68 L33 96" stroke="#303530"/><path d="M8 51 L36 34 L60 48 L32 65Z" fill="currentColor" fill-opacity=".28" stroke-width=".8"/><g fill="#242925" stroke="none"><ellipse cx="18" cy="51" rx="2.5" ry="1.8" transform="rotate(-30 18 51)"/><ellipse cx="29" cy="44" rx="2.5" ry="1.8" transform="rotate(-30 29 44)"/><ellipse cx="39" cy="39" rx="2.5" ry="1.8" transform="rotate(-30 39 39)"/><ellipse cx="30" cy="58" rx="2.5" ry="1.8" transform="rotate(-30 30 58)"/><ellipse cx="41" cy="51" rx="2.5" ry="1.8" transform="rotate(-30 41 51)"/><ellipse cx="51" cy="46" rx="2.5" ry="1.8" transform="rotate(-30 51 46)"/><ellipse cx="17" cy="69" rx="2.4" ry="3.8" transform="rotate(-25 17 69)"/><ellipse cx="26" cy="83" rx="2.4" ry="3.8" transform="rotate(-25 26 83)"/><ellipse cx="41" cy="72" rx="2.5" ry="3.3" transform="rotate(25 41 72)"/><ellipse cx="55" cy="62" rx="2.5" ry="3.3" transform="rotate(25 55 62)"/><ellipse cx="42" cy="86" rx="2.5" ry="3.3" transform="rotate(25 42 86)"/><ellipse cx="55" cy="77" rx="2.5" ry="3.3" transform="rotate(25 55 77)"/></g></g></g>',
        'viking-axe': '<g transform="scale(2.56)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M55 9 L61 12 L24 95 L18 92Z" fill="currentColor" fill-opacity=".65" stroke-width="1.7"/><path d="M58 19 Q72 26 84 12 Q94 43 66 61 Q68 42 48 35Z" fill="currentColor" fill-opacity=".75" stroke-width="1.8"/><path d="M84 12 Q84 39 66 61 M56 25 Q71 32 85 26 M52 31 Q64 36 72 40" stroke-width="1" opacity=".65"/><path d="M48 13 L61 18 L59 24 L44 18Z" fill="currentColor" fill-opacity=".65" stroke-width="1.3"/><path d="M23 84 L29 87 M26 77 L32 80 M29 70 L35 73 M32 63 L38 66 M35 56 L41 59 M39 47 L44 50 M49 25 L55 28 M47 31 L52 34" stroke="#303530" stroke-width="1.2"/></g>',
    } %}
    {% set commandNetForums = [] %}
    {% for unitForum in repository('Forumify\\Forum\\Entity\\Forum').findBy({slug: unitDefinitions|keys}, {position: 'ASC'}) %}
        {% if can('view', unitForum) %}
            {% set commandNetForums = commandNetForums|merge([unitForum]) %}
        {% endif %}
    {% endfor %}
    {% set commandNetUnitForums = commandNetForums %}
    {# A community need not use the example unit slugs to have a useful homepage. #}
    {% if commandNetForums is empty %}
        {% for availableForum in repository('Forumify\\Forum\\Entity\\Forum').findBy({}, {position: 'ASC'}, 50) %}
            {% if can('view', availableForum) and commandNetForums|length < 6 %}
                {% set commandNetForums = commandNetForums|merge([availableForum]) %}
            {% endif %}
        {% endfor %}
    {% endif %}
    <div class="cn-shell">
        <a class="cn-skip" href="#cn-main">Skip to content</a>
        {% block command_net_sidebar %}
            <aside class="cn-sidebar" aria-label="Community navigation">
                <a class="cn-brand" href="{{ path('forumify_core_index') }}">
                    {% if setting('forumify.logo') %}
                        <img src="{{ asset(setting('forumify.logo'), 'forumify.asset') }}" alt="" class="cn-patch">
                    {% else %}
                        <img src="{{ asset('themes/majesticdev/command-net-theme/images/spearhead.png') }}" alt="" class="cn-patch">
                    {% endif %}
                    <strong>{{ setting('forumify.title')|default('Spearhead Gaming', true) }}</strong>
                    <span>People / Units / Operations</span>
                </a>
                <nav class="cn-navigation" aria-label="Main navigation">
                    <a href="{{ path('forumify_core_index') }}"><i class="ph ph-house" aria-hidden="true"></i>Home</a>
                    <a href="{{ path('forumify_forum_forum') }}"><i class="ph ph-chats" aria-hidden="true"></i>Forums</a>
                    {{ forum_menu() }}
                </nav>
                <p class="cn-motto">Discipline<br>Brotherhood<br>Good times<br>Always forward</p>
            </aside>
        {% endblock %}
        <div class="cn-workspace">
            {% include '@Forumify/frontend/blocks/header/header.html.twig' %}
            {% include '@Forumify/frontend/blocks/alerts.html.twig' %}
            {% block command_net_hero %}
                {% set commandTitle = commandTitle|default('Command Net') %}
                {% set communityTagline = communityTagline|default('Ordinary players. Extraordinary brotherhood.') %}
                <section class="cn-hero" aria-label="Command Net">
                    <div class="cn-heading">
                        <p class="cn-eyebrow">{{ communityTagline }}</p>
                        <div class="cn-title-line"><p class="cn-wordmark" data-text="{{ commandTitle }}">{{ commandTitle }}</p><span class="cn-drill" aria-hidden="true">Plan<br>Coordinate<br>Deploy<br>Play<br>Repeat</span></div>
                        <p class="cn-subtitle">{{ setting('forumify.title')|default('Spearhead Gaming', true) }}</p>
                    </div>
                    <aside class="cn-operation" aria-label="Operations briefing">
                        {% block command_net_operation %}
                            {% set briefing = snippet('command-net-operation') %}
                            {% if briefing|trim %}
                                {# snippet() returns platform-rendered/sanitized CMS markup; a fully custom briefing wins over the default below. #}
                                {{ briefing|raw }}
                            {% elseif commandNetPluginActive %}
                                {% set nextOperation = repository('MajesticDev\\CommandNet\\Entity\\Operation').findNextUpcoming() %}
                                {% set upcomingCount = repository('MajesticDev\\CommandNet\\Entity\\Operation').countUpcoming() %}
                                {# Admin-editable, not polled: create these CMS snippets to fill them in, see README. #}
                                {% set serverStatus = snippet('command-net-server-status')|trim %}
                                <h2>
                                    <i class="ph ph-tree-evergreen" aria-hidden="true"></i>
                                    <span class="cn-operation-title">{{ nextOperation ? (nextOperation.title starts with 'Operation' ? nextOperation.title : 'Operation ' ~ nextOperation.title) : 'Operation briefing' }}</span>
                                    {% if nextOperation and nextOperation.status.value == 'in_progress' %}
                                        <span class="cn-live"><i class="ph ph-circle-fill" aria-hidden="true"></i> Live</span>
                                    {% endif %}
                                </h2>
                                <dl>
                                    <div><dt>Community status</dt><dd><i class="ph ph-circle-fill cn-dot-online" aria-hidden="true"></i> Online {% include '@CommandNetPlugin/frontend/online_count.html.twig' ignore missing %}</dd></div>
                                    <div><dt>Operations</dt><dd>{{ upcomingCount }} upcoming</dd></div>
                                    <div><dt>Upcoming event</dt><dd>{{ nextOperation ? nextOperation.startDateTime|format_date(true) : 'None scheduled' }}</dd></div>
                                    {% if serverStatus %}<div><dt>Server status</dt><dd>{{ serverStatus }}</dd></div>{% endif %}
                                </dl>
                                <a href="{{ path('forumify_forum_forum') }}">Open community forums <span aria-hidden="true">↗</span></a>
                            {% else %}
                                {# No commandnet-plugin and no CMS snippet - a plain fallback rather than a hard error. #}
                                <h2><i class="ph ph-tree-evergreen" aria-hidden="true"></i> Operation briefing</h2>
                                <p>Create a "command-net-operation" CMS snippet to fill in this panel.</p>
                                <a href="{{ path('forumify_forum_forum') }}">Open community forums <span aria-hidden="true">↗</span></a>
                            {% endif %}
                        {% endblock %}
                    </aside>
                    <div class="cn-hud" aria-hidden="true">
                        <div class="cn-compass">
                            <svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="128" cy="128" r="74"/>
                                <path d="M128 30 V226 M30 128 H226"/>
                                <path d="M128 58 L146 128 L128 198 L110 128 Z"/>
                            </svg>
                        </div>
                        {% set coordinates = snippet('command-net-coordinates')|trim %}
                        {% if coordinates %}<p class="cn-coordinates">{{ coordinates }}</p>{% endif %}
                        <p class="cn-grid-ref">{{ snippet('command-net-grid-ref')|trim|default('AO SPEARHEAD', true) }}</p>
                    </div>
                </section>
            {% endblock %}
            {% block command_net_units %}
                <nav class="cn-units" aria-label="Unit channels">
                    {% for slug, unit in unitDefinitions %}
                        {% set matches = commandNetUnitForums|filter(f => f.slug == slug) %}
                        {% set unitForum = matches|first %}
                        {# The traced Misfit emblem keeps its original colors and is cached separately. #}
                        {% if unit.icon == 'misfit-skull' %}
                            {% set iconMarkup = '<img class="cn-unit-icon" src="' ~ asset('themes/majesticdev/command-net-theme/images/icons/units/misfit-skull.svg') ~ '" alt="" aria-hidden="true">' %}
                        {% else %}
                            {% set iconMarkup = unitIconPaths[unit.icon] is defined
                                ? '<svg class="cn-unit-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' ~ unitIconPaths[unit.icon] ~ '</svg>'
                                : '<i class="ph ph-' ~ unit.icon ~ '" aria-hidden="true"></i>' %}
                        {% endif %}
                        {% if unitForum %}
                            <a href="{{ path('forumify_forum_forum', {slug: unitForum.slug}) }}" {% if forum is defined and forum is not null and forum.id == unitForum.id %}aria-current="page"{% endif %}>
                                {{ iconMarkup|raw }}
                                <span><strong>{{ unit.label }}</strong><small>{{ unit.subtitle }}</small></span>
                            </a>
                        {% else %}
                            <span class="cn-unit-unavailable" aria-disabled="true" title="Channel unavailable">
                                {{ iconMarkup|raw }}
                                <span><strong>{{ unit.label }}</strong><small>{{ unit.subtitle }}</small></span>
                            </span>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endblock %}
            {% block body_wrapper %}
                <main id="cn-main" class="cn-main" tabindex="-1">
                    {% block main %}{% block body %}{% endblock %}{% endblock %}
                </main>
            {% endblock %}
            <div class="cn-signoff"><span>{{ setting('forumify.title') }}</span><span>Same ground. Different stories. One brotherhood.</span></div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('themes/majesticdev/command-net-theme/command-net.js') }}?v=20260925" defer></script>
{% endblock %}
